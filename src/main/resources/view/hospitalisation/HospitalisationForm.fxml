<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hsp.controller.hospitalisation.HospitalisationFormController">

    <VBox spacing="20" style="-fx-padding: 20;">

        <!-- En-tete -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="titre" text="Nouvelle hospitalisation"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </HBox>

        <Separator/>

        <!-- Formulaire -->
        <Label text="Informations de l'hospitalisation"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="15" vgap="12" style="-fx-padding: 0 0 0 10;">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="75"/>
            </columnConstraints>

            <!-- Dossier -->
            <Label text="Dossier / Patient *" style="-fx-font-weight: bold;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboDossier" prefWidth="450" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Chambre -->
            <Label text="Chambre *" style="-fx-font-weight: bold;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboChambre" prefWidth="450" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- ID Medecin -->
            <Label text="ID Medecin *" style="-fx-font-weight: bold;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="idMedecin" promptText="Identifiant du medecin responsable"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Date debut -->
            <Label text="Date de debut *" style="-fx-font-weight: bold;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateDebut" prefWidth="450" maxWidth="Infinity"
                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Date fin -->
            <Label text="Date de fin" style="-fx-font-weight: bold;"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <HBox spacing="10" alignment="CENTER_LEFT"
                  GridPane.rowIndex="4" GridPane.columnIndex="1">
                <DatePicker fx:id="dateFin" prefWidth="350"/>
                <CheckBox fx:id="enCours" text="En cours (pas de date de fin)" selected="true"/>
            </HBox>

        </GridPane>

        <Separator/>

        <!-- Description maladie -->
        <Label text="Description de la maladie"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <TextArea fx:id="descriptionMaladie"
                  promptText="Decrivez la maladie ou le motif d'hospitalisation..."
                  prefHeight="120" wrapText="true"
                  style="-fx-padding: 0 0 0 10;"/>

        <Separator/>

        <!-- Boutons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="annuler" text="Annuler" onAction="#annuler"
                    style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" prefWidth="120"/>
            <Button fx:id="valider" text="Enregistrer" onAction="#valider"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120"/>
        </HBox>

    </VBox>
</ScrollPane>
