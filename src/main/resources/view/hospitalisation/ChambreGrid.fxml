<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.chambre.ChambreListController">

    <!-- En-tete -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tableau des Chambres"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="ajouter" text="+ Ajouter une chambre" onAction="#ajouterChambre"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Rafraichir" onAction="#rafraichir"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Legende + Filtres -->
    <HBox spacing="20" alignment="CENTER_LEFT">

        <!-- Legende -->
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="Legende :" style="-fx-font-weight: bold;"/>
            <Label style="-fx-background-color: #4CAF50; -fx-min-width: 16;
                          -fx-min-height: 16; -fx-background-radius: 3;"/>
            <Label text="Disponible"/>
            <Label style="-fx-background-color: #f44336; -fx-min-width: 16;
                          -fx-min-height: 16; -fx-background-radius: 3;"/>
            <Label text="Occupee"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Recherche -->
        <TextField fx:id="recherche" promptText="Rechercher (numero, etage...)"
                   prefWidth="220" onAction="#rechercher"/>
        <Button text="Rechercher" onAction="#rechercher"
                style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>

        <!-- Filtre disponibilite -->
        <Label text="Filtre :"/>
        <ComboBox fx:id="filtre" prefWidth="140"/>

    </HBox>

    <!-- Tableau des chambres -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="numero" text="Numero" prefWidth="150"/>
            <TableColumn fx:id="etage" text="Etage" prefWidth="120"/>
            <TableColumn fx:id="nbLits" text="Nb Lits" prefWidth="100"/>
            <TableColumn fx:id="disponible" text="Disponible" prefWidth="120"/>
        </columns>
        <placeholder>
            <Label text="Aucune chambre trouvee"/>
        </placeholder>
    </TableView>

    <!-- Actions -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="modifier" text="Modifier" onAction="#modifierChambre"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;" prefWidth="110"/>
        <Button fx:id="supprimer" text="Supprimer" onAction="#supprimerChambre"
                style="-fx-background-color: #f44336; -fx-text-fill: white;" prefWidth="110"/>
        <Button fx:id="details" text="Details" onAction="#afficherDetails"
                style="-fx-background-color: #9C27B0; -fx-text-fill: white;" prefWidth="110"/>
    </HBox>

</VBox>
