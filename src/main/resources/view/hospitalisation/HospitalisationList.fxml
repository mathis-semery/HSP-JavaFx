<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.hospitalisation.HospitalisationListController">

    <!-- En-tete -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestion des Hospitalisations"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="ajouter" text="+ Nouvelle hospitalisation" onAction="#ajouterHospitalisation"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Rafraichir" onAction="#rafraichir"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <!-- Barre de recherche et filtre -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="recherche" promptText="Rechercher (ID, patient, chambre...)"
                   prefWidth="320" onAction="#rechercher"/>
        <Button text="Rechercher" onAction="#rechercher"
                style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>
        <Label text="Statut :"/>
        <ComboBox fx:id="filtre" prefWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tableau -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="dossierCol" text="Dossier / Patient" prefWidth="220"/>
            <TableColumn fx:id="chambreCol" text="Chambre" prefWidth="110"/>
            <TableColumn fx:id="idMedecinCol" text="Medecin" prefWidth="110"/>
            <TableColumn fx:id="dateDebutCol" text="Date debut" prefWidth="110"/>
            <TableColumn fx:id="dateFinCol" text="Date fin" prefWidth="110"/>
            <TableColumn fx:id="statutCol" text="Statut" prefWidth="100"/>
        </columns>
        <placeholder>
            <Label text="Aucune hospitalisation trouvee"/>
        </placeholder>
    </TableView>

    <!-- Actions bas de page -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="modifier" text="Modifier" onAction="#modifierHospitalisation"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;" prefWidth="110"/>
        <Button fx:id="supprimer" text="Supprimer" onAction="#supprimerHospitalisation"
                style="-fx-background-color: #f44336; -fx-text-fill: white;" prefWidth="110"/>
        <Button fx:id="details" text="Details" onAction="#afficherDetails"
                style="-fx-background-color: #9C27B0; -fx-text-fill: white;" prefWidth="110"/>
    </HBox>

</VBox>
