<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.produit.ProduitFormController"
      spacing="16"
      prefWidth="420"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Titre dynamique -->
    <Label fx:id="titre"
           text="Produit"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

    <Separator/>

    <!-- Libellé -->
    <VBox spacing="4">
        <Label text="Libellé *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="libelleField" promptText="Nom du produit (max 100 caractères)"/>
    </VBox>

    <!-- Description -->
    <VBox spacing="4">
        <Label text="Description"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextArea fx:id="descriptionField"
                  promptText="Description du produit…"
                  prefRowCount="3"
                  wrapText="true"/>
    </VBox>

    <!-- Dangerosité -->
    <VBox spacing="4">
        <Label text="Niveau de dangerosité *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <ComboBox fx:id="dangerositeCombo" maxWidth="Infinity"/>
    </VBox>

    <!-- Quantité en stock -->
    <VBox spacing="4">
        <Label text="Quantité en stock *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <Spinner fx:id="stockSpinner" maxWidth="Infinity" editable="true"/>
    </VBox>

    <Separator/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="annuler"
                text="Annuler"
                onAction="#annuler"
                style="-fx-background-color: #e0e0e0; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
        <Button fx:id="valider"
                text="✔ Valider"
                onAction="#valider"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
    </HBox>

</VBox>
