<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.stock.StockFormController"
      spacing="16"
      prefWidth="420"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Titre -->
    <Label fx:id="titre"
           text="Mouvement de Stock"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

    <Separator/>

    <!-- Type de mouvement -->
    <VBox spacing="4">
        <Label text="Type de mouvement *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <ComboBox fx:id="typeMouvement" maxWidth="Infinity"/>
    </VBox>

    <!-- Quantité -->
    <VBox spacing="4">
        <Label text="Quantité *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="quantite" promptText="Ex : 50"/>
    </VBox>

    <!-- Motif -->
    <VBox spacing="4">
        <Label text="Motif *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextArea fx:id="motif"
                  promptText="Décrivez la raison du mouvement…"
                  prefRowCount="3"
                  wrapText="true"/>
    </VBox>

    <Separator/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="annuler"
                text="Annuler"
                onAction="#annuler"
                style="-fx-background-color: #e0e0e0; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
        <Button fx:id="valider"
                text="✔ Enregistrer"
                onAction="#valider"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
    </HBox>

</VBox>
