<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.produit_fournisseur.ProduitFournisseurFormController"
      spacing="16"
      prefWidth="420"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Titre dynamique -->
    <Label fx:id="titre"
           text="Association Produit — Fournisseur"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

    <Separator/>

    <!-- Produit (désactivé en modification) -->
    <VBox spacing="4">
        <Label text="Produit *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <ComboBox fx:id="produitField" maxWidth="Infinity"
                  promptText="Sélectionnez un produit"/>
    </VBox>

    <!-- Fournisseur (désactivé en modification) -->
    <VBox spacing="4">
        <Label text="Fournisseur *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <ComboBox fx:id="fournisseurField" maxWidth="Infinity"
                  promptText="Sélectionnez un fournisseur"/>
    </VBox>

    <!-- Prix -->
    <VBox spacing="4">
        <Label text="Prix unitaire (€) *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="prixField" promptText="Ex : 12.50"/>
    </VBox>

    <Separator/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="annuler"
                text="Annuler"
                onAction="#annuler"
                style="-fx-background-color: #e0e0e0; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
        <Button fx:id="valider"
                text="✔ Valider"
                onAction="#valider"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
    </HBox>

</VBox>
