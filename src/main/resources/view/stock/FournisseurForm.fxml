<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.fournisseur.FournisseurFormController"
      spacing="16"
      prefWidth="440"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <!-- Titre dynamique -->
    <Label fx:id="titre"
           text="Fournisseur"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

    <Separator/>

    <!-- Nom -->
    <VBox spacing="4">
        <Label text="Nom *"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="nomField" promptText="Nom du fournisseur (max 100 caractères)"/>
    </VBox>

    <!-- Contact -->
    <VBox spacing="4">
        <Label text="Personne de contact"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="contactField" promptText="Nom du contact principal"/>
    </VBox>

    <!-- Email -->
    <VBox spacing="4">
        <Label text="Adresse email"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="emailField" promptText="exemple@domaine.com"/>
    </VBox>

    <!-- Téléphone -->
    <VBox spacing="4">
        <Label text="Téléphone"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="telephoneField" promptText="Ex : +33 1 23 45 67 89"/>
    </VBox>

    <!-- Adresse -->
    <VBox spacing="4">
        <Label text="Adresse"
               style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextArea fx:id="adresseField"
                  promptText="Adresse complète du fournisseur…"
                  prefRowCount="3"
                  wrapText="true"/>
    </VBox>

    <Separator/>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="annuler"
                text="Annuler"
                onAction="#annuler"
                style="-fx-background-color: #e0e0e0; -fx-font-weight: bold;
                       -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
        <Button fx:id="valider"
                text="✔ Valider"
                onAction="#valider"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18 8 18;"/>
    </HBox>

</VBox>
