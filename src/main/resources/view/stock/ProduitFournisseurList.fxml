<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.produit_fournisseur.ProduitFournisseurListController"
      spacing="12"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <!-- Titre -->
    <Label text="Produits ↔ Fournisseurs"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
    <Label text="Associations entre produits et fournisseurs avec leur prix unitaire"
           style="-fx-font-size: 12px; -fx-text-fill: #888;"/>

    <!-- Barre de recherche -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="recherche"
                   promptText="Rechercher par produit ou fournisseur…"
                   prefWidth="300"
                   onKeyReleased="#rechercher"/>
        <Button text="🔄 Rafraîchir"
                onAction="#rafraichir"
                style="-fx-background-color: #e0e0e0; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tableau -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="produitCol"      text="Produit"       prefWidth="220"/>
            <TableColumn fx:id="fournisseurCol"  text="Fournisseur"   prefWidth="220"/>
            <TableColumn fx:id="prixCol"         text="Prix unitaire" prefWidth="130"/>
        </columns>
        <placeholder>
            <Label text="Aucune association trouvée."
                   style="-fx-text-fill: #888; -fx-font-size: 14px;"/>
        </placeholder>
    </TableView>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="ajouter"
                text="➕ Associer"
                onAction="#ajouterLien"
                style="-fx-background-color: #34a853; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
        <Button fx:id="modifier"
                text="✏️ Modifier prix"
                onAction="#modifierLien"
                style="-fx-background-color: #f9a825; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
        <Button fx:id="supprimer"
                text="🗑 Dissocier"
                onAction="#supprimerLien"
                style="-fx-background-color: #e53935; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16 8 16;"/>
    </HBox>

</VBox>
