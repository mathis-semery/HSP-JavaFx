<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsp.controller.stock.StockListController"
      spacing="20"
      prefWidth="700"
      prefHeight="500"
      style="-fx-background-color: #f0f4f8;">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <!-- Titre -->
    <VBox spacing="4">
        <Label fx:id="titre"
               text="Gestion des Stocks"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
        <Label text="Sélectionnez un module à gérer"
               style="-fx-font-size: 13px; -fx-text-fill: #888;"/>
    </VBox>

    <Separator/>

    <!-- Grille de boutons modules -->
    <GridPane hgap="16" vgap="16">

        <!-- Produits -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20; -fx-cursor: hand;"
              prefWidth="180" prefHeight="130"
              onMouseClicked="#ouvrirProduits"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="📦" style="-fx-font-size: 32px;"/>
            <Label text="Produits"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
            <Label text="Gérer les produits médicaux"
                   style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-wrap-text: true;"
                   maxWidth="160"/>
        </VBox>

        <!-- Fournisseurs -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20; -fx-cursor: hand;"
              prefWidth="180" prefHeight="130"
              onMouseClicked="#ouvrirFournisseurs"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="🏭" style="-fx-font-size: 32px;"/>
            <Label text="Fournisseurs"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
            <Label text="Gérer les fournisseurs"
                   style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-wrap-text: true;"
                   maxWidth="160"/>
        </VBox>

        <!-- Demandes -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20; -fx-cursor: hand;"
              prefWidth="180" prefHeight="130"
              onMouseClicked="#ouvrirDemandes"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="📋" style="-fx-font-size: 32px;"/>
            <Label text="Demandes"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
            <Label text="Gérer les demandes de produits"
                   style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-wrap-text: true;"
                   maxWidth="160"/>
        </VBox>

        <!-- Réapprovisionnement -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20; -fx-cursor: hand;"
              prefWidth="180" prefHeight="130"
              onMouseClicked="#ouvrirReapprovisionnement"
              GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="🔄" style="-fx-font-size: 32px;"/>
            <Label text="Réapprovisionnement"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
            <Label text="Gérer les commandes fournisseurs"
                   style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-wrap-text: true;"
                   maxWidth="160"/>
        </VBox>

        <!-- Statistiques -->
        <VBox spacing="8" alignment="CENTER"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                     -fx-padding: 20; -fx-cursor: hand;"
              prefWidth="180" prefHeight="130"
              onMouseClicked="#ouvrirStatistiques"
              GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="📊" style="-fx-font-size: 32px;"/>
            <Label text="Statistiques"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
            <Label text="En cours de développement"
                   style="-fx-font-size: 11px; -fx-text-fill: #aaa; -fx-wrap-text: true;"
                   maxWidth="160"/>
        </VBox>

    </GridPane>

</VBox>
