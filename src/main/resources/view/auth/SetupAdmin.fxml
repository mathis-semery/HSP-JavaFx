<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.hsp.controller.login.SetupAdminController"
           style="-fx-background-color: #f1f5f9;">

    <VBox alignment="CENTER" maxWidth="440" spacing="0"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40;">
        <effect>
            <DropShadow color="#00000033" radius="30" spread="0.2"/>
        </effect>

        <!-- Icône -->
        <StackPane prefHeight="70" prefWidth="70" style="-fx-background-color: #dc2626; -fx-background-radius: 35;">
            <Label text="&#x1F451;" style="-fx-font-size: 32;"/>
        </StackPane>

        <!-- Titre -->
        <Label text="Configuration initiale"
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b;">
            <VBox.margin><Insets top="20" bottom="4"/></VBox.margin>
        </Label>

        <!-- Sous-titre -->
        <Label text="Aucun administrateur trouvé. Créez le premier compte."
               style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-wrap-text: true; -fx-text-alignment: center;"
               maxWidth="360">
            <VBox.margin><Insets bottom="24"/></VBox.margin>
        </Label>

        <!-- Nom / Prénom côte à côte -->
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Nom" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                <TextField fx:id="nomField" promptText="Dupont"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Prénom" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
                <TextField fx:id="prenomField" promptText="Jean"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14;"/>
            </VBox>
        </HBox>

        <!-- Email -->
        <VBox spacing="6">
            <VBox.margin><Insets top="14"/></VBox.margin>
            <Label text="Email" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
            <TextField fx:id="emailField" promptText="admin@hopital.fr"
                       style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14;"/>
        </VBox>

        <!-- Mot de passe -->
        <VBox spacing="6">
            <VBox.margin><Insets top="14"/></VBox.margin>
            <Label text="Mot de passe" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
            <PasswordField fx:id="passwordField" promptText="Au moins 6 caractères"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14;"/>
        </VBox>

        <!-- Confirmer mot de passe -->
        <VBox spacing="6">
            <VBox.margin><Insets top="14"/></VBox.margin>
            <Label text="Confirmer le mot de passe" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: #4a5568;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14;"/>
        </VBox>

        <!-- Message d'erreur -->
        <Label fx:id="errorLabel" text="" visible="false"
               style="-fx-text-fill: #dc2626; -fx-font-size: 13; -fx-wrap-text: true;" maxWidth="360">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <!-- Bouton -->
        <Button text="Créer le compte administrateur" maxWidth="Infinity"
                onAction="#onCreateClicked"
                style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14; -fx-cursor: hand;">
            <VBox.margin><Insets top="24"/></VBox.margin>
        </Button>

    </VBox>

</StackPane>
