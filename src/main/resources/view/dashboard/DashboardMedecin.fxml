<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hsp.controller.dashboard.MedecinDashboardController"
            style="-fx-background-color: #f5f5f5;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: #667eea; -fx-padding: 20;" alignment="CENTER_LEFT" spacing="20">
            <Label text="⚕️ HSP - MÉDECIN" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" text="[Médecin]" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Button text="🔒 Déconnexion" onAction="#onLogout"
                    style="-fx-background-color: white; -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox style="-fx-background-color: #1f2937; -fx-padding: 20;" spacing="10" prefWidth="250">
            <Label text="NAVIGATION" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Separator/>

            <Button text="📊 Tableau de bord" onAction="#showDashboard" prefWidth="220"
                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>
            <Button text="👥 Patients en attente" onAction="#showWaitingPatients" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>
            <Button text="🛏️ Hospitalisations" onAction="#showHospitalizations" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>
            <Button text="💊 Demandes produits" onAction="#showProductRequests" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>
            <Button text="📋 Historique" onAction="#showHistory" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>
            <Button text="📄 Mes ordonnances" onAction="#showOrdonnances" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-background-color: #374151; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Patients en attente" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label fx:id="waitingCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox style="-fx-background-color: #374151; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Hospitalisations actives" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label fx:id="hospitalizationCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENT AREA WITH SCROLLPANE -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white;">
            <StackPane fx:id="contentPane" style="-fx-background-color: white;">
                <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

                <!-- ========================================== -->
                <!-- DASHBOARD VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="dashboardView" spacing="25">
                    <Label text="Tableau de bord médecin" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <!-- KPI Cards -->
                    <HBox spacing="20">
                        <VBox style="-fx-background-color: #dbeafe; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="280">
                            <Label text="👥 Aujourd'hui" style="-fx-text-fill: #1e40af; -fx-font-weight: bold;"/>
                            <Label fx:id="todayPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                            <Label text="patients" style="-fx-text-fill: #60a5fa; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox style="-fx-background-color: #fef3c7; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="280">
                            <Label text="⏰ En attente" style="-fx-text-fill: #b45309; -fx-font-weight: bold;"/>
                            <Label fx:id="waitingPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                            <Label text="patients" style="-fx-text-fill: #fbbf24; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox style="-fx-background-color: #f3e8ff; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="280">
                            <Label text="🛏️ Hospitalisations" style="-fx-text-fill: #6b21a8; -fx-font-weight: bold;"/>
                            <Label fx:id="hospitalizationsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                            <Label text="actives" style="-fx-text-fill: #a78bfa; -fx-font-size: 12px;"/>
                        </VBox>

                        <VBox style="-fx-background-color: #d1fae5; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="280">
                            <Label text="💊 Demandes" style="-fx-text-fill: #065f46; -fx-font-weight: bold;"/>
                            <Label fx:id="productRequestsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                            <Label text="en attente" style="-fx-text-fill: #34d399; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <!-- Patients urgents -->
                    <VBox spacing="15">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label text="🚨 Patients urgents" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Filtrer par gravité :" style="-fx-font-size: 14px;"/>
                            <ComboBox fx:id="gravityFilterComboBox" prefWidth="130"/>
                        </HBox>
                        <TableView fx:id="urgentPatientsTable" prefHeight="300"/>
                    </VBox>
                </VBox>

                <!-- ========================================== -->
                <!-- WAITING PATIENTS VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="waitingPatientsView" spacing="20" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="Patients en salle d'attente" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualiser" onAction="#onRefreshWaiting"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView fx:id="waitingPatientsTable" prefHeight="600"/>
                </VBox>

                <!-- ========================================== -->
                <!-- HOSPITALIZATIONS VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="hospitalizationsView" spacing="20" visible="false">
                    <Label text="Mes hospitalisations" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <!-- Hospitalisations actives -->
                    <VBox spacing="15">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <Label text="🛏️ Hospitalisations en cours" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="➕ Nouvelle hospitalisation" onAction="#onNewHospitalization"
                                    style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        </HBox>
                        <TableView fx:id="activeHospitalizationsTable" prefHeight="300"/>
                    </VBox>

                    <!-- Hospitalisations terminées -->
                    <VBox spacing="15">
                        <Label text="✅ Hospitalisations terminées" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <TableView fx:id="completedHospitalizationsTable" prefHeight="300"/>
                    </VBox>
                </VBox>

                <!-- ========================================== -->
                <!-- PRODUCT REQUESTS VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="productRequestsView" spacing="20" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="Mes demandes de produits" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕ Nouvelle demande" onAction="#onNewProductRequest"
                                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView fx:id="myRequestsTable" prefHeight="600"/>
                </VBox>

                <!-- ========================================== -->
                <!-- TREATMENT VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="treatmentView" spacing="20" visible="false">
                    <Label text="Prise en charge patient" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <!-- Informations patient -->
                    <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                        <Label text="👤 Informations patient" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <HBox spacing="30">
                            <VBox spacing="5">
                                <Label text="Patient :" style="-fx-text-fill: #6b7280;"/>
                                <Label fx:id="patientNameLabel" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Arrivée :" style="-fx-text-fill: #6b7280;"/>
                                <Label fx:id="arrivalDateLabel" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label text="Gravité :" style="-fx-text-fill: #6b7280;"/>
                                <Label fx:id="gravityLevelLabel" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="5">
                            <Label text="Symptômes :" style="-fx-text-fill: #6b7280;"/>
                            <TextArea fx:id="symptomsTextArea" editable="false" prefHeight="80" wrapText="true"
                                      style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1;"/>
                        </VBox>
                    </VBox>

                    <!-- Décision -->
                    <VBox spacing="15" style="-fx-padding: 25; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-background-color: white; -fx-border-radius: 8;">
                        <Label text="💊 Décision médicale" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <RadioButton fx:id="ordonnanceRadio" text="Ordonnance (sortie du patient)"
                                     style="-fx-font-size: 14px;"/>
                        <RadioButton fx:id="hospitalizationRadio" text="Hospitalisation"
                                     style="-fx-font-size: 14px;"/>
                    </VBox>

                    <!-- Détails hospitalisation -->
                    <VBox fx:id="hospitalizationDetails" spacing="15" visible="false"
                          style="-fx-padding: 25; -fx-border-color: #d97706; -fx-border-width: 2; -fx-background-color: #fef3c7; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <Label text="🏥 Détails de l'hospitalisation" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #92400e;"/>

                        <VBox spacing="5">
                            <Label text="Chambre :" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="chambreComboBox" promptText="Sélectionner une chambre disponible" prefWidth="300"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Diagnostic / Description de la maladie :" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="maladieTextArea" promptText="Décrire le diagnostic et le plan de traitement..."
                                      prefHeight="120" wrapText="true"/>
                        </VBox>
                    </VBox>

                    <!-- Boutons d'action -->
                    <HBox spacing="15" style="-fx-padding: 20 0 0 0;">
                        <Button text="✅ Valider la prise en charge" onAction="#onValidateTreatment"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-cursor: hand;"/>
                        <Button text="❌ Annuler" onAction="#onCancelTreatment"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 15 30; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- ========================================== -->
                <!-- HISTORIQUE VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="historiqueView" spacing="20" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="Mon historique d'activité" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📥 Exporter" onAction="#onExportHistorique"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Filtres -->
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #f9fafb; -fx-background-radius: 8;">
                        <Label text="Filtrer par :" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <DatePicker fx:id="histoDateFilter" promptText="Sélectionner une date" prefWidth="170"/>
                        <ComboBox fx:id="histoActionFilter" promptText="Type d'action" prefWidth="200"/>
                        <Button text="🔍 Filtrer" onAction="#onFilterHistorique"
                                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand;"/>
                        <Button text="🔄 Réinitialiser" onAction="#onResetFilters"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Table Historique -->
                    <TableView fx:id="historiqueTable" prefHeight="500" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="histoDateCol" text="Date/Heure" prefWidth="180"/>
                            <TableColumn fx:id="histoActionCol" text="Action" prefWidth="150"/>
                            <TableColumn fx:id="histoTableCol" text="Table concernée" prefWidth="150"/>
                            <TableColumn fx:id="histoDetailsCol" text="Détails" prefWidth="520"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 50;">
                                <Label text="📋" style="-fx-font-size: 48px;"/>
                                <Label text="Aucune entrée dans l'historique" style="-fx-text-fill: #9ca3af; -fx-font-size: 16px;"/>
                                <Label text="Vos actions s'afficheront ici automatiquement" style="-fx-text-fill: #d1d5db; -fx-font-size: 12px;"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <!-- Compteur -->
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                        <Label text="📊" style="-fx-font-size: 16px;"/>
                        <Label fx:id="historiqueCountLabel" text="0 entrée(s)" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- ========================================== -->
                <!-- ORDONNANCES VIEW -->
                <!-- ========================================== -->
                <VBox fx:id="ordonnancesView" spacing="20" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <Label text="Mes ordonnances prescrites" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Actualiser" onAction="#onRefreshOrdonnances"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView fx:id="ordonnancesTable" prefHeight="600"
                               style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 50;">
                                <Label text="📄" style="-fx-font-size: 48px;"/>
                                <Label text="Aucune ordonnance prescrite" style="-fx-text-fill: #9ca3af; -fx-font-size: 16px;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="📊" style="-fx-font-size: 16px;"/>
                        <Label fx:id="ordonnancesCountLabel" text="0 ordonnance(s)" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

            </StackPane>
        </ScrollPane>
    </center>

</BorderPane>