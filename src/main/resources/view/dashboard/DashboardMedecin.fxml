<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hsp.controller.dashboard.MedecinDashboardController"
            stylesheets="@../../css/dashboard.css"
            style="-fx-background-color: #f5f5f5;">

    <!-- HEADER -->
    <top>
        <HBox style="-fx-background-color: #667eea; -fx-padding: 20;">
            <Label fx:id="userNameLabel" text="Dr. [Nom]" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Déconnexion" onAction="#onLogout" style="-fx-background-color: white; -fx-text-fill: #667eea;"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox style="-fx-background-color: #2d3748; -fx-padding: 20;" spacing="10" prefWidth="250">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Separator/>

            <Button text="📋 Tableau de bord" onAction="#showDashboard" prefWidth="220"
                    style="-fx-background-color: #4a5568; -fx-text-fill: white;"/>
            <Button text="🩺 Patients en attente" onAction="#showWaitingPatients" prefWidth="220"
                    style="-fx-background-color: #4a5568; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-background-color: #4a5568; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Patients à traiter" style="-fx-text-fill: #a0aec0;"/>
                <Label fx:id="waitingCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white;">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- Dashboard View (default) -->
            <VBox fx:id="dashboardView" spacing="20">
                <Label text="Tableau de bord" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <!-- Stats Cards -->
                <HBox spacing="20">
                    <VBox style="-fx-background-color: #e6f2ff; -fx-padding: 20; -fx-background-radius: 10;" spacing="10" prefWidth="200">
                        <Label text="Patients aujourd'hui" style="-fx-text-fill: #1a73e8;"/>
                        <Label fx:id="todayPatientsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>
                    </VBox>

                    <VBox style="-fx-background-color: #fff3e0; -fx-padding: 20; -fx-background-radius: 10;" spacing="10" prefWidth="200">
                        <Label text="En attente" style="-fx-text-fill: #f57c00;"/>
                        <Label fx:id="waitingPatientsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f57c00;"/>
                    </VBox>

                    <VBox style="-fx-background-color: #f3e5f5; -fx-padding: 20; -fx-background-radius: 10;" spacing="10" prefWidth="200">
                        <Label text="Hospitalisations" style="-fx-text-fill: #8e24aa;"/>
                        <Label fx:id="hospitalizationsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #8e24aa;"/>
                    </VBox>

                    <VBox style="-fx-background-color: #e8f5e9; -fx-padding: 20; -fx-background-radius: 10;" spacing="10" prefWidth="200">
                        <Label text="Demandes produits" style="-fx-text-fill: #388e3c;"/>
                        <Label fx:id="productRequestsLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #388e3c;"/>
                    </VBox>
                </HBox>

                <!-- Message de test -->
                <Label text="✅ Le dashboard est chargé et visible !"
                       style="-fx-font-size: 18px; -fx-text-fill: #388e3c; -fx-padding: 20; -fx-background-color: #e8f5e9; -fx-background-radius: 5;"/>

                <!-- Urgent Patients Table -->
                <VBox style="-fx-background-color: #fff8f8; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="⚠️ Patients urgents (Gravité 4-5)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #d32f2f;"/>
                    <TableView fx:id="urgentPatientsTable" prefHeight="200">
                        <columns>
                            <TableColumn text="Patient" prefWidth="200"/>
                            <TableColumn text="Arrivée" prefWidth="150"/>
                            <TableColumn text="Symptômes" prefWidth="300"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Waiting Patients View -->
            <VBox fx:id="waitingPatientsView" spacing="20" visible="false">
                <Label text="Patients en attente" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Liste des patients en attente..." style="-fx-font-size: 16px;"/>

                <ComboBox fx:id="gravityFilterComboBox" prefWidth="150" promptText="Tous"/>
                <TableView fx:id="waitingPatientsTable" prefHeight="500">
                    <columns>
                        <TableColumn text="Patient" prefWidth="200"/>
                        <TableColumn text="Arrivée" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Hospitalizations View -->
            <VBox fx:id="hospitalizationsView" spacing="20" visible="false">
                <Label text="Mes hospitalisations" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <TableView fx:id="activeHospitalizationsTable" prefHeight="400">
                    <columns>
                        <TableColumn text="Patient" prefWidth="200"/>
                    </columns>
                </TableView>
                <TableView fx:id="completedHospitalizationsTable" prefHeight="0"/>
            </VBox>

            <!-- Product Requests View -->
            <VBox fx:id="productRequestsView" spacing="20" visible="false">
                <Label text="Demandes de produits" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <TableView fx:id="myRequestsTable" prefHeight="400">
                    <columns>
                        <TableColumn text="Date" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Treatment View -->
            <VBox fx:id="treatmentView" spacing="20" visible="false">
                <Label text="Prise en charge du patient" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                <Label fx:id="patientNameLabel" text="[Nom]"/>
                <Label fx:id="arrivalDateLabel" text="[Date]"/>
                <Label fx:id="gravityLevelLabel" text="[Gravité]"/>
                <TextArea fx:id="symptomsTextArea" prefRowCount="3"/>

                <RadioButton fx:id="ordonnanceRadio" text="Ordonnance"/>
                <RadioButton fx:id="hospitalizationRadio" text="Hospitalisation"/>

                <VBox fx:id="hospitalizationDetails" visible="false">
                    <ComboBox fx:id="chambreComboBox" promptText="Chambre"/>
                    <TextArea fx:id="maladieTextArea" promptText="Maladie" prefRowCount="3"/>
                </VBox>

                <HBox spacing="10">
                    <Button text="Valider" onAction="#onValidateTreatment"/>
                    <Button text="Annuler" onAction="#onCancelTreatment"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
