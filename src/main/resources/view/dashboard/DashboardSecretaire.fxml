<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hsp.controller.dashboard.SecretaireDashboardController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: #10b981; -fx-padding: 20;" alignment="CENTER_LEFT" spacing="20">
            <Label text="🏥 HSP - Secrétaire" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" text="[Nom]" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Déconnexion" onAction="#onLogout" style="-fx-background-color: white; -fx-text-fill: #10b981; -fx-padding: 10 20;"/>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #1f2937; -fx-padding: 20;" spacing="10" prefWidth="250">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="📋 Tableau de bord" onAction="#showDashboard" prefWidth="220"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="➕ Enregistrer patient" onAction="#showPatientRegistration" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="👥 Liste patients" onAction="#showPatientList" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="🚨 Triage" onAction="#showTriage" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-background-color: #374151; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Patients aujourd'hui" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label fx:id="todayCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white;">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <VBox fx:id="dashboardView" spacing="25">
                <Label text="Tableau de bord" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <VBox style="-fx-background-color: #ecfdf5; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="📅 Aujourd'hui" style="-fx-text-fill: #059669; -fx-font-weight: bold;"/>
                        <Label fx:id="todayPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #fef3c7; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="⏳ En attente" style="-fx-text-fill: #d97706; -fx-font-weight: bold;"/>
                        <Label fx:id="waitingPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #dbeafe; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="🩺 Triés" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                        <Label fx:id="triagedPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                </HBox>
                <VBox spacing="15" style="-fx-padding: 25; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                    <Label text="📋 Derniers patients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="recentPatientsTable" prefHeight="300">
                        <columns>
                            <TableColumn text="Nom" prefWidth="200"/>
                            <TableColumn text="Arrivée" prefWidth="150"/>
                            <TableColumn text="Statut" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <VBox fx:id="registrationView" spacing="20" visible="false">
                <Label text="Nouveau patient" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="20" style="-fx-padding: 30;">
                        <GridPane hgap="20" vgap="15">
                            <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>
                            <Label text="Prénom :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="prenomField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>
                            <Label text="Date naissance :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="dateNaissancePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>
                            <Label text="Sexe :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="sexeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>
                            <Label text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="telephoneField" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
                            <Label text="Adresse :" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="adresseField" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="300"/>
                        </GridPane>
                        <VBox spacing="10">
                            <Label text="Motif :" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="motifTextArea" prefRowCount="3"/>
                        </VBox>
                        <HBox spacing="15">
                            <Button text="✅ Enregistrer" onAction="#onSavePatient"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12 30;"/>
                            <Button text="❌ Annuler" onAction="#showDashboard"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 30;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="patientListView" spacing="20" visible="false">
                <Label text="Liste des patients" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TextField fx:id="searchField" promptText="🔍 Rechercher..."/>
                <TableView fx:id="allPatientsTable" prefHeight="500">
                    <columns>
                        <TableColumn text="Nom" prefWidth="200"/>
                        <TableColumn text="Téléphone" prefWidth="120"/>
                        <TableColumn text="Statut" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="triageView" spacing="20" visible="false">
                <Label text="Triage" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TableView fx:id="waitingTriageTable" prefHeight="400">
                    <columns>
                        <TableColumn text="Patient" prefWidth="200"/>
                        <TableColumn text="Arrivée" prefWidth="150"/>
                        <TableColumn text="Motif" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>
        </StackPane>
    </center>
</BorderPane>