<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hsp.controller.dashboard.SecretaireDashboardController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: #10b981; -fx-padding: 20;" alignment="CENTER_LEFT" spacing="20">
            <Label text="🏥 HSP - Secrétaire" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" text="[Nom]" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Déconnexion" onAction="#onLogout" style="-fx-background-color: white; -fx-text-fill: #10b981; -fx-padding: 10 20;"/>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #1f2937; -fx-padding: 20;" spacing="10" prefWidth="250">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="📋 Tableau de bord"      onAction="#showDashboard"           prefWidth="220" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="➕ Enregistrer patient"   onAction="#showPatientRegistration" prefWidth="220" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="👥 Liste patients"        onAction="#showPatientList"         prefWidth="220" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="🚨 Triage"                onAction="#showTriage"              prefWidth="220" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="📅 Rendez-vous"           onAction="#showRendezVous"          prefWidth="220" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="📜 Historique"            onAction="#showHistorique"          prefWidth="220" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-background-color: #374151; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Patients aujourd'hui" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label fx:id="todayCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white;">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <!-- ═══════════════ DASHBOARD ═══════════════ -->
            <VBox fx:id="dashboardView" spacing="25">
                <Label text="Tableau de bord" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <VBox style="-fx-background-color: #ecfdf5; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="📅 Aujourd'hui" style="-fx-text-fill: #059669; -fx-font-weight: bold;"/>
                        <Label fx:id="todayPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #fef3c7; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="⏳ En attente" style="-fx-text-fill: #d97706; -fx-font-weight: bold;"/>
                        <Label fx:id="waitingPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #dbeafe; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="250">
                        <Label text="🩺 Triés" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                        <Label fx:id="triagedPatientsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                </HBox>
                <VBox spacing="15" style="-fx-padding: 25; -fx-border-color: #e5e7eb; -fx-border-width: 1;">
                    <Label text="📋 Derniers patients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="recentPatientsTable" prefHeight="300">
                        <columns>
                            <TableColumn text="Nom"     prefWidth="200"/>
                            <TableColumn text="Arrivée" prefWidth="150"/>
                            <TableColumn text="Statut"  prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ═══════════════ CRÉATION PATIENT ═══════════════ -->
            <VBox fx:id="registrationView" spacing="20" visible="false">
                <Label text="Nouveau patient" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="20" style="-fx-padding: 30;">
                        <GridPane hgap="20" vgap="15">
                            <Label text="Nom :"               GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="nomField"        GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>
                            <Label text="Prénom :"             GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="prenomField"     GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>
                            <Label text="Date naissance :"     GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="dateNaissancePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>
                            <Label text="Sexe :"               GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="sexeComboBox"     GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>
                            <Label text="Téléphone :"          GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="telephoneField"  GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
                            <Label text="Adresse :"            GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="adresseField"    GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="300"/>
                            <Label text="N° Sécurité sociale :" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="numSecuField" promptText="185126912345678" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="300"/>
                            <Label text="Email :"              GridPane.columnIndex="0" GridPane.rowIndex="7" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="emailPatientField" promptText="patient@email.com" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="300"/>
                            <Label text="Motif de la première visite :" GridPane.columnIndex="0" GridPane.rowIndex="8" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="motifPremVisite" GridPane.columnIndex="1" GridPane.rowIndex="8" prefWidth="300" prefRowCount="3"
                                      promptText="Décrivez les symptômes ou le motif…"/>
                        </GridPane>
                        <HBox spacing="15">
                            <Button text="✅ Enregistrer" onAction="#onSavePatient"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12 30;"/>
                            <Button text="❌ Annuler" onAction="#showDashboard"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 30;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ═══════════════ LISTE PATIENTS ═══════════════ -->
            <VBox fx:id="patientListView" spacing="15" visible="false">
                <Label text="Liste des patients" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher par nom ou prénom…"
                               prefWidth="300" onKeyReleased="#onRefreshList"/>
                    <Button text="🔄 Rafraîchir" onAction="#onRefreshList"
                            style="-fx-background-color: #e5e7eb; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
                <TableView fx:id="allPatientsTable" VBox.vgrow="ALWAYS" prefHeight="400">
                    <columns>
                        <TableColumn text="Nom"       prefWidth="160"/>
                        <TableColumn text="Prénom"    prefWidth="130"/>
                        <TableColumn text="Téléphone" prefWidth="120"/>
                        <TableColumn text="Email"     prefWidth="180"/>
                        <TableColumn text="Statut"    prefWidth="110"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnNouvelleVisite"
                            text="🏥 Nouvelle visite"
                            onAction="#onNouvelleVisite"
                            disable="true"
                            style="-fx-background-color: #10b981; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                    <Button fx:id="btnVoirDossiers"
                            text="📁 Voir dossiers"
                            onAction="#onVoirDossiersPatientSelectionne"
                            disable="true"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                    <Button fx:id="btnModifierPatient"
                            text="✏️ Modifier la fiche"
                            onAction="#onModifierPatient"
                            disable="true"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                    <Button fx:id="btnSupprimerPatient"
                            text="🗑 Supprimer"
                            onAction="#onSupprimerPatient"
                            disable="true"
                            style="-fx-background-color: #e53935; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                </HBox>
            </VBox>

            <!-- ═══════════════ NOUVELLE VISITE ═══════════════ -->
            <VBox fx:id="nouvelleVisiteView" spacing="20" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button text="← Retour liste" onAction="#showPatientList"
                            style="-fx-background-color: #e5e7eb; -fx-cursor: hand; -fx-padding: 8 14;"/>
                    <Label text="Nouvelle visite" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </HBox>
                <!-- Rappel identité patient -->
                <VBox style="-fx-background-color: #f0fdf4; -fx-padding: 20;
                             -fx-border-color: #10b981; -fx-border-width: 1;
                             -fx-background-radius: 8;" spacing="6">
                    <Label text="Patient identifié" style="-fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    <Label fx:id="nvPatientInfoLabel" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="nvPatientSecuLabel" text="N° Sécu : —" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="nvDerniereVisiteLabel" text="Dernière visite : —" style="-fx-text-fill: #6b7280;"/>
                </VBox>
                <!-- Formulaire -->
                <VBox spacing="10">
                    <Label text="Motif de la visite :" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <TextArea fx:id="nvMotifArea" prefRowCount="4"
                              promptText="Décrivez les symptômes ou le motif de consultation…"/>
                </VBox>
                <HBox spacing="15">
                    <Button text="✅ Enregistrer la visite" onAction="#onSauvegarderNouvelleVisite"
                            style="-fx-background-color: #10b981; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 30;"/>
                    <Button text="❌ Annuler" onAction="#showPatientList"
                            style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 30;"/>
                </HBox>
            </VBox>

            <!-- ═══════════════ DOSSIERS PATIENT ═══════════════ -->
            <VBox fx:id="dossiersPatientView" spacing="15" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button text="← Retour liste" onAction="#showPatientList"
                            style="-fx-background-color: #e5e7eb; -fx-cursor: hand; -fx-padding: 8 14;"/>
                    <Label fx:id="dossiersPatientTitreLabel" text="Dossiers du patient"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </HBox>
                <!-- Fiche identité -->
                <VBox style="-fx-background-color: #f0fdf4; -fx-padding: 20;
                             -fx-border-color: #10b981; -fx-border-width: 1;
                             -fx-background-radius: 8;" spacing="8">
                    <Label text="Identité du patient" style="-fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    <HBox spacing="30">
                        <Label fx:id="ficheNomLabel"   text="Nom : —"      style="-fx-font-size: 14px;"/>
                        <Label fx:id="ficheTelLabel"   text="Tél : —"      style="-fx-font-size: 14px;"/>
                        <Label fx:id="ficheEmailLabel" text="Email : —"    style="-fx-font-size: 14px;"/>
                        <Label fx:id="ficheSecuLabel"  text="N° Sécu : —"  style="-fx-font-size: 14px;"/>
                    </HBox>
                </VBox>
                <!-- Stats -->
                <HBox spacing="15">
                    <VBox style="-fx-background-color: #dbeafe; -fx-padding: 15; -fx-background-radius: 8;" spacing="5" prefWidth="160">
                        <Label text="Total visites"  style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold;"/>
                        <Label fx:id="statsTotalLabel"   text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #fef3c7; -fx-padding: 15; -fx-background-radius: 8;" spacing="5" prefWidth="160">
                        <Label text="En attente"     style="-fx-text-fill: #d97706; -fx-font-weight: bold;"/>
                        <Label fx:id="statsAttenteLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #dcfce7; -fx-padding: 15; -fx-background-radius: 8;" spacing="5" prefWidth="160">
                        <Label text="Terminés"       style="-fx-text-fill: #15803d; -fx-font-weight: bold;"/>
                        <Label fx:id="statsTermineLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>
                </HBox>
                <Label text="Toutes les visites (passées et en cours)"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <TableView fx:id="dossiersTable" VBox.vgrow="ALWAYS" prefHeight="350">
                    <columns>
                        <TableColumn text="Date arrivée" prefWidth="160"/>
                        <TableColumn text="Statut"       prefWidth="110"/>
                        <TableColumn text="Gravité"      prefWidth="80"/>
                        <TableColumn text="Motif"        prefWidth="300"/>
                        <TableColumn text="Médecin"      prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- ═══════════════ ÉDITION PATIENT ═══════════════ -->
            <VBox fx:id="editPatientView" spacing="20" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button text="← Retour liste" onAction="#showPatientList"
                            style="-fx-background-color: #e5e7eb; -fx-cursor: hand; -fx-padding: 8 14;"/>
                    <Label text="Modifier la fiche patient"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </HBox>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <GridPane hgap="20" vgap="15">
                            <Label text="Nom :"       GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editNomField"     GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>
                            <Label text="Prénom :"    GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editPrenomField"  GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>
                            <Label text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editTelField"     GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>
                            <Label text="Email :"     GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editEmailField"   GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>
                            <Label text="Adresse :"   GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editAdresseField" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
                            <Label text="N° Sécu :"   GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="editNumSecuField" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="300"/>
                        </GridPane>
                        <HBox spacing="15">
                            <Button text="✅ Enregistrer les modifications" onAction="#onSaveEditPatient"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 30;"/>
                            <Button text="❌ Annuler" onAction="#showPatientList"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 30;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ═══════════════ TRIAGE ═══════════════ -->
            <VBox fx:id="triageView" spacing="20" visible="false">
                <Label text="Triage" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TableView fx:id="waitingTriageTable" prefHeight="400">
                    <columns>
                        <TableColumn text="Patient"   prefWidth="200"/>
                        <TableColumn text="Arrivée"   prefWidth="150"/>
                        <TableColumn text="Gravité"   prefWidth="100"/>
                        <TableColumn text="Motif"     prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- ═══════════════ RENDEZ-VOUS (LISTE) ═══════════════ -->
            <VBox fx:id="rendezVousView" spacing="15" visible="false">
                <Label text="Rendez-vous" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="rdvSearchField" promptText="🔍 Rechercher patient ou médecin…"
                               prefWidth="300" onKeyReleased="#onRefreshRdv"/>
                    <Button text="🔄 Rafraîchir" onAction="#onRefreshRdv"
                            style="-fx-background-color: #e5e7eb; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="➕ Nouveau RDV" onAction="#showNouveauRdv"
                            style="-fx-background-color: #10b981; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                </HBox>
                <TableView fx:id="rdvTable" VBox.vgrow="ALWAYS" prefHeight="420">
                    <columns>
                        <TableColumn text="Patient"  prefWidth="160"/>
                        <TableColumn text="Médecin"  prefWidth="160"/>
                        <TableColumn text="Date RDV" prefWidth="150"/>
                        <TableColumn text="Motif"    prefWidth="200"/>
                        <TableColumn text="Statut"   prefWidth="110"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnModifierRdv" text="✏️ Modifier"
                            onAction="#onModifierRdv" disable="true"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                    <Button fx:id="btnAnnulerRdv" text="❌ Annuler le RDV"
                            onAction="#onAnnulerRdv" disable="true"
                            style="-fx-background-color: #e53935; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
                </HBox>
            </VBox>

            <!-- ═══════════════ RENDEZ-VOUS (FORMULAIRE) ═══════════════ -->
            <VBox fx:id="rdvFormView" spacing="20" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button text="← Retour" onAction="#showRendezVous"
                            style="-fx-background-color: #e5e7eb; -fx-cursor: hand; -fx-padding: 8 14;"/>
                    <Label fx:id="rdvFormTitle" text="Nouveau rendez-vous"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </HBox>
                <ScrollPane fitToWidth="true">
                    <VBox spacing="20" style="-fx-padding: 30;">
                        <GridPane hgap="20" vgap="15">
                            <Label text="Patient :"       GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="rdvPatientCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                      prefWidth="300" promptText="Sélectionner un patient…"/>
                            <Label text="Médecin :"       GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="rdvMedecinCombo" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      prefWidth="300" promptText="Sélectionner un médecin…"/>
                            <Label text="Date :"          GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                            <DatePicker fx:id="rdvDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>
                            <Label text="Heure (HH:mm) :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                            <TextField fx:id="rdvHeureField" promptText="ex: 09:30"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="300"/>
                            <Label text="Statut :"        GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="rdvStatutCombo" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
                        </GridPane>
                        <VBox spacing="8">
                            <Label text="Motif :" style="-fx-font-weight: bold;"/>
                            <TextArea fx:id="rdvMotifArea" prefRowCount="3"/>
                        </VBox>
                        <HBox spacing="15">
                            <Button text="✅ Enregistrer" onAction="#onSaveRdv"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 12 30;"/>
                            <Button text="❌ Annuler" onAction="#showRendezVous"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 12 30;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- ═══════════════ HISTORIQUE ═══════════════ -->
            <VBox fx:id="historiqueView" spacing="15" visible="false">
                <Label text="Historique des actions" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="historiqueSearchField"
                               promptText="🔍 Rechercher dans l'historique…"
                               prefWidth="280" onKeyReleased="#onSearchHistorique"/>
                    <ComboBox fx:id="historiqueActionFilter" promptText="Toutes les actions"
                              prefWidth="200" onAction="#onSearchHistorique"/>
                    <Button text="🔄 Rafraîchir" onAction="#onSearchHistorique"
                            style="-fx-background-color: #e5e7eb; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
                <TableView fx:id="historiqueTable" VBox.vgrow="ALWAYS" prefHeight="500">
                    <columns>
                        <TableColumn text="Date"        prefWidth="160"/>
                        <TableColumn text="Action"      prefWidth="120"/>
                        <TableColumn text="Table"       prefWidth="130"/>
                        <TableColumn text="Utilisateur" prefWidth="160"/>
                        <TableColumn text="Détails"     prefWidth="380"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
