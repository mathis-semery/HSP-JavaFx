<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hsp.controller.dashboard.GestionnaireDashboardController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <HBox style="-fx-background-color: #8b5cf6; -fx-padding: 20;" alignment="CENTER_LEFT" spacing="20">
            <Label text="🏥 HSP - Gestionnaire" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" text="[Nom]" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Button text="Déconnexion" onAction="#onLogout" style="-fx-background-color: white; -fx-text-fill: #8b5cf6; -fx-padding: 10 20;"/>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #1f2937; -fx-padding: 20;" spacing="10" prefWidth="250">
            <Label text="MENU" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Separator/>
            <Button text="📋 Tableau de bord" onAction="#showDashboard" prefWidth="220"
                    style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="📦 Stock produits" onAction="#showStock" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="📋 Demandes" onAction="#showDemandes" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="🏢 Fournisseurs" onAction="#showFournisseurs" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Button text="🔄 Réapprovisionnement" onAction="#showReappro" prefWidth="220"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-padding: 12;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-background-color: #374151; -fx-padding: 15; -fx-background-radius: 8;">
                <Label text="Stock faible" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                <Label fx:id="lowStockCountLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: white;">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

            <!-- ===== TABLEAU DE BORD ===== -->
            <VBox fx:id="dashboardView" spacing="25">
                <Label text="Tableau de bord" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <VBox style="-fx-background-color: #f3e8ff; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="220">
                        <Label text="📦 Total produits" style="-fx-text-fill: #7c3aed; -fx-font-weight: bold;"/>
                        <Label fx:id="totalProductsLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #fef3c7; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="220">
                        <Label text="⚠️ Stock faible" style="-fx-text-fill: #d97706; -fx-font-weight: bold;"/>
                        <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    </VBox>
                    <VBox style="-fx-background-color: #dbeafe; -fx-padding: 25; -fx-background-radius: 12;" spacing="10" prefWidth="220">
                        <Label text="📋 Demandes" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                        <Label fx:id="pendingDemandesLabel" text="0" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                    </VBox>
                </HBox>
                <VBox spacing="10" style="-fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8;">
                    <Label text="📦 Aperçu du stock (produits les plus faibles)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="productsTable" prefHeight="280"/>
                </VBox>
            </VBox>

            <!-- ===== STOCK PRODUITS ===== -->
            <VBox fx:id="stockView" spacing="20" visible="false" managed="false">
                <Label text="Gestion du stock" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                <!-- Formulaire ajout -->
                <VBox spacing="15" style="-fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8;">
                    <Label text="Ajouter un produit" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <GridPane hgap="20" vgap="12">
                        <Label text="Nom produit *" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="productNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="280" promptText="Libellé du produit"/>
                        <Label text="Quantité *" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="quantityField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="280" promptText="Quantité initiale en stock"/>
                        <Label text="Dangerosité (1-5) *" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="dangerositeProduitComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="280"/>
                        <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="descriptionProduitField" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="280" promptText="Description (optionnel)"/>
                    </GridPane>
                    <Button text="✅ Ajouter au stock" onAction="#onAddProduct"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 24; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Liste + actions -->
                <VBox spacing="10" style="-fx-padding: 20; -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                    <Label text="Liste des produits" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <TableView fx:id="stockProductsTable" VBox.vgrow="ALWAYS" prefHeight="300"/>
                    <HBox spacing="12">
                        <Button text="✏️ Modifier" onAction="#onEditProduct"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                        <Button text="🗑 Supprimer" onAction="#onDeleteProduct"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ===== DEMANDES ===== -->
            <VBox fx:id="demandesView" spacing="20" visible="false" managed="false">
                <Label text="Demandes de produits" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TableView fx:id="demandesTable" VBox.vgrow="ALWAYS" prefHeight="450"/>
                <HBox spacing="15">
                    <Button text="✅ Valider" onAction="#onValidateDemande"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 24; -fx-font-weight: bold;"/>
                    <Button text="❌ Rejeter" onAction="#onRejectDemande"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 24; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- ===== FOURNISSEURS ===== -->
            <VBox fx:id="fournisseursView" spacing="20" visible="false" managed="false">
                <Label text="Fournisseurs" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TableView fx:id="fournisseursTable" VBox.vgrow="ALWAYS" prefHeight="450"/>
                <HBox spacing="12">
                    <Button text="➕ Ajouter" onAction="#onAddFournisseur"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    <Button text="✏️ Modifier" onAction="#onEditFournisseur"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    <Button text="🗑 Supprimer" onAction="#onDeleteFournisseur"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- ===== RÉAPPROVISIONNEMENT ===== -->
            <VBox fx:id="reapproView" spacing="20" visible="false" managed="false">
                <Label text="Réapprovisionnements" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <TableView fx:id="reapproTable" VBox.vgrow="ALWAYS" prefHeight="450"/>
                <HBox spacing="12">
                    <Button text="➕ Nouveau" onAction="#onAddReappro"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    <Button text="✅ Confirmer réception" onAction="#onConfirmReception"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    <Button text="🗑 Supprimer" onAction="#onDeleteReappro"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
